<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent_gold"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vat_title"
                android:textColor="@color/text_mid"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_theme"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="☀ Light"
            android:textColor="@color/accent_gold"
            android:background="@drawable/chip_btn"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dual Pane Split Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Pane: Inputs & Modes -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Amount Input Card -->
                <LinearLayout
                    android:id="@+id/card_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_amount_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enter_amount"
                        android:textColor="@color/text_mid"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/ll_input_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/edittext_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/tv_peso_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱"
                            android:textColor="@color/accent_gold"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_amount"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="0.00"
                            android:textColorHint="@color/text_muted"
                            android:textColor="@color/text_high"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Quick Presets -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/chip_100"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="+₱100"
                                android:textColor="@color/text_mid"
                                android:background="@drawable/chip_btn"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/chip_500"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="+₱500"
                                android:textColor="@color/text_mid"
                                android:background="@drawable/chip_btn"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/chip_1000"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="+₱1K"
                                android:textColor="@color/text_mid"
                                android:background="@drawable/chip_btn"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/chip_5000"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="+₱5K"
                                android:textColor="@color/text_mid"
                                android:background="@drawable/chip_btn"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/chip_10000"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="+₱10K"
                                android:textColor="@color/text_mid"
                                android:background="@drawable/chip_btn"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Mode & Option Card -->
                <LinearLayout
                    android:id="@+id/card_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_mode_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculation Mode"
                        android:textColor="@color/accent_cyan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingBottom="10dp" />

                    <RadioGroup
                        android:id="@+id/rg_vat_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_inclusive"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="@string/inclusive_label"
                            android:textColor="@color/text_high"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rb_exclusive"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/exclusive_label"
                            android:textColor="@color/text_high"
                            android:textSize="14sp" />
                    </RadioGroup>

                    <View
                        android:id="@+id/divider_mode"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_card"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <Switch
                        android:id="@+id/sw_senior_pwd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/senior_pwd_label"
                        android:textColor="@color/text_high"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Action Button Clear -->
                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/clear"
                    android:textColor="@color/text_mid"
                    android:background="@drawable/btn_action"
                    android:textSize="14sp" />

            </LinearLayout>
        </ScrollView>

        <!-- Right Pane: Result Breakdown & Copy -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Result Card -->
                <LinearLayout
                    android:id="@+id/card_breakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_breakdown_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tax &amp; Price Breakdown"
                        android:textColor="@color/accent_gold"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingBottom="12dp" />

                    <!-- Total Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/tv_total_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_amount"
                            android:textColor="@color/text_high"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_total_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/accent_emerald"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_breakdown"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_card"
                        android:layout_marginBottom="14dp" />

                    <!-- Vatable Sales -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tv_vatable_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vatable_sales"
                            android:textColor="@color/text_mid"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_vatable_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/text_high"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- VAT Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tv_vat_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vat_amount"
                            android:textColor="@color/text_mid"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_vat_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/accent_cyan"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Senior / PWD Discount (Hidden by default) -->
                    <LinearLayout
                        android:id="@+id/ll_discount_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tv_discount_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/discount_amount"
                            android:textColor="@color/accent_gold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_discount_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-₱0.00"
                            android:textColor="@color/accent_gold"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Formula / Explanatory Note -->
                    <TextView
                        android:id="@+id/tv_formula_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Formula: Vatable Sales = Amount ÷ 1.12 | VAT = Vatable Sales × 12%"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Copy Summary Button -->
                <Button
                    android:id="@+id/btn_copy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/copy"
                    android:textColor="@color/accent_gold"
                    android:background="@drawable/btn_action"
                    android:textSize="14sp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</LinearLayout>
