<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FASTTRACK"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline Fasting Sentinel"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnThemeToggle"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Theme"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- Main Athletic HUD Hero Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="?android:attr/colorBackgroundFloating"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENTINEL READY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="16dp" />

            <!-- Ultra-Large Readout -->
            <TextView
                android:id="@+id/tvTimerDigits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="12dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressFasting"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="100"
                android:progress="0"
                android:layout_marginBottom="16dp" />

            <!-- Telemetry Matrix -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET"
                        android:textSize="10sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvTargetReadout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16h 00m"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ELAPSED"
                        android:textSize="10sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvElapsedReadout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00h 00m 00s"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REMAINING"
                        android:textSize="10sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvRemainingReadout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16h 00m 00s"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Metabolic Stage Indicator -->
            <TextView
                android:id="@+id/tvMetabolicStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stage: Digestion &amp; Anabolism (Fed State)"
                android:textSize="12sp"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="18dp" />

            <!-- Primary Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToggleFast"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="START FAST"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <Button
                    android:id="@+id/btnResetFast"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:text="RESET"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fasting Protocols Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FASTING PROTOCOLS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnProto16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16:8 Lean"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnProto18"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:6 Prime"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnProto20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:4 Warrior"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnProto24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24:0 OMAD"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Custom Target Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Goal:"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <SeekBar
                android:id="@+id/sbTargetHours"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="36"
                android:progress="16" />

            <TextView
                android:id="@+id/tvSeekValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="16h"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="end"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- Sentinel Hydration Tracker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?android:attr/colorBackgroundFloating"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HYDRATION TRACKER"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/tvWaterCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 mL"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddWater250"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+250 mL (Space)"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAddWater500"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+500 mL"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnResetWater"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Telemetry History & Data Backup -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FASTING LOG &amp; AUDIT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary" />

            <Button
                android:id="@+id/btnClearHistory"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistoryLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="?android:attr/colorBackgroundFloating"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp" />

        <!-- Zero-Data-Loss JSON Import / Export -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExportData"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Export / Share JSON"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnImportData"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Import JSON"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>