<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/m3_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sentinel_subheadline"
                    android:textSize="12sp"
                    android:textColor="@color/m3_outline" />
            </LinearLayout>

            <Button
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_m3_outlined"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/theme_auto"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_surface" />
        </LinearLayout>

        <!-- Sentinel Status Hero Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_m3"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sentinel_overview_header"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary" />

            <TextView
                android:id="@+id/tvSentinelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sentinel_all_healthy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tracked_meds_label"
                        android:textSize="12sp"
                        android:textColor="@color/m3_outline" />

                    <TextView
                        android:id="@+id/tvTotalMedsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/critical_refills_label"
                        android:textSize="12sp"
                        android:textColor="@color/m3_outline" />

                    <TextView
                        android:id="@+id/tvCriticalRefillsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_error" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btnQuickDoseSelected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_m3_primary"
                    android:minHeight="44dp"
                    android:text="@string/quick_dose_action"
                    android:textColor="@color/m3_on_primary"
                    android:textSize="13sp"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnExportReport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:minHeight="44dp"
                    android:text="@string/export_share_report"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- New Prescription Entry Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_m3_high"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_medication_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etMedName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_m3"
                android:hint="@string/hint_med_name"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/m3_on_surface"
                android:textColorHint="@color/m3_outline"
                android:textSize="14sp"
                android:inputType="textCapWords"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etDosage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_m3"
                android:hint="@string/hint_dosage"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/m3_on_surface"
                android:textColorHint="@color/m3_outline"
                android:textSize="14sp"
                android:inputType="text"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etCurrentCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/edittext_m3"
                    android:hint="@string/hint_current_pills"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/m3_on_surface"
                    android:textColorHint="@color/m3_outline"
                    android:textSize="14sp"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/etDailyDose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/edittext_m3"
                    android:hint="@string/hint_daily_dose"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/m3_on_surface"
                    android:textColorHint="@color/m3_outline"
                    android:textSize="14sp"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/refill_threshold_label"
                    android:textSize="13sp"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvThresholdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_threshold_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekRefillThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnSaveMedication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_m3_primary"
                android:minHeight="46dp"
                android:text="@string/add_medication_action"
                android:textColor="@color/m3_on_primary"
                android:textSize="14sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Medications Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/active_prescriptions_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface"
            android:layout_marginBottom="10dp" />

        <!-- Dynamic Medications List Container -->
        <LinearLayout
            android:id="@+id/containerMedicationsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>