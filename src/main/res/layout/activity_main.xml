<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/m3_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Material 3 Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IRONPULSE"
                android:textColor="@color/m3_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Material 3 Offline Gym Tracker &amp; Rest Timer"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Program & Exercise Selection Card (M3 Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_m3"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORKOUT PROGRAM"
                android:textColor="@color/m3_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="10dp" />

            <!-- Material 3 Filter Chips (Horizontal) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnChipPPL"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/chip_active"
                        android:text="Push / Pull / Legs"
                        android:textColor="@color/m3_on_primary"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Select Push Pull Legs split" />

                    <Button
                        android:id="@+id/btnChipUpperLower"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/chip_inactive"
                        android:text="Upper / Lower"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Select Upper Lower split" />

                    <Button
                        android:id="@+id/btnChip5x5"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/chip_inactive"
                        android:text="5x5 Strength"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Select 5x5 Strength program" />

                    <Button
                        android:id="@+id/btnChipCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/chip_inactive"
                        android:text="Custom Split"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:contentDescription="Select Custom split" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Hidden spinner to preserve adapter state if needed -->
            <Spinner
                android:id="@+id/spinnerProgram"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET EXERCISE"
                android:textColor="@color/m3_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerExercise"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/card_m3_high"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="Select exercise" />

            <!-- Material 3 Progressive Overload Cue Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_m3_high"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvProgressiveCue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Overload Cue: Log consistently to unlock suggestions."
                    android:textColor="@color/m3_success"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Material 3 Active Set Logger Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_m3"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOG ACTIVE SET"
                android:textColor="@color/m3_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="14dp" />

            <!-- Weight & Reps Columns with M3 Steppers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="14dp">

                <!-- Weight Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight (kg)"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etWeight"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_m3"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:hint="80.0"
                        android:textColorHint="@color/m3_outline_variant"
                        android:inputType="numberDecimal"
                        android:contentDescription="Enter weight in kilograms" />

                    <!-- Quick Stepper Buttons for Weight -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginTop="6dp">

                        <Button
                            android:id="@+id/btnWeightMinus5"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/btn_stepper"
                            android:text="-5"
                            android:textSize="10sp"
                            android:textColor="@color/m3_on_surface"
                            android:contentDescription="Decrease weight by 5 kg" />

                        <Button
                            android:id="@+id/btnWeightMinus25"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/btn_stepper"
                            android:text="-2.5"
                            android:textSize="10sp"
                            android:textColor="@color/m3_on_surface"
                            android:contentDescription="Decrease weight by 2.5 kg" />

                        <Button
                            android:id="@+id/btnWeightPlus25"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/btn_stepper"
                            android:text="+2.5"
                            android:textSize="10sp"
                            android:textColor="@color/m3_primary"
                            android:textStyle="bold"
                            android:contentDescription="Increase weight by 2.5 kg" />

                        <Button
                            android:id="@+id/btnWeightPlus5"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_stepper"
                            android:text="+5"
                            android:textSize="10sp"
                            android:textColor="@color/m3_primary"
                            android:textStyle="bold"
                            android:contentDescription="Increase weight by 5 kg" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Reps Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reps Count"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etReps"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_m3"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:hint="8"
                        android:textColorHint="@color/m3_outline_variant"
                        android:inputType="number"
                        android:contentDescription="Enter reps count" />

                    <!-- Quick Stepper Buttons for Reps -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginTop="6dp">

                        <Button
                            android:id="@+id/btnRepsMinus5"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/btn_stepper"
                            android:text="-5"
                            android:textSize="10sp"
                            android:textColor="@color/m3_on_surface"
                            android:contentDescription="Decrease reps by 5" />

                        <Button
                            android:id="@+id/btnRepsMinus1"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/btn_stepper"
                            android:text="-1"
                            android:textSize="10sp"
                            android:textColor="@color/m3_on_surface"
                            android:contentDescription="Decrease reps by 1" />

                        <Button
                            android:id="@+id/btnRepsPlus1"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/btn_stepper"
                            android:text="+1"
                            android:textSize="10sp"
                            android:textColor="@color/m3_primary"
                            android:textStyle="bold"
                            android:contentDescription="Increase reps by 1" />

                        <Button
                            android:id="@+id/btnRepsPlus5"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_stepper"
                            android:text="+5"
                            android:textSize="10sp"
                            android:textColor="@color/m3_primary"
                            android:textStyle="bold"
                            android:contentDescription="Increase reps by 5" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Material 3 Primary Log Set Button -->
            <Button
                android:id="@+id/btnLogSet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_m3_primary"
                android:text="Log Set &amp; Start Rest Timer"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:contentDescription="Log set and start rest timer" />

            <!-- Active Sets List Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Workout Sets"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutCurrentSetsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnClearCurrentSets"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_m3_outlined"
                    android:text="Clear Sets"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_error"
                    android:contentDescription="Clear current workout sets" />

                <Button
                    android:id="@+id/btnFinishWorkout"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="Finish Workout"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_primary_container"
                    android:textStyle="bold"
                    android:contentDescription="Complete workout and record history" />
            </LinearLayout>
        </LinearLayout>

        <!-- Material 3 Rest Interval Timer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_m3"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REST INTERVAL TIMER"
                android:textColor="@color/m3_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvTimerCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="01:30"
                android:textColor="@color/m3_primary"
                android:textSize="40sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <ProgressBar
                android:id="@+id/pbTimer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:progressTint="@color/m3_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">

                <Button
                    android:id="@+id/btnTimer60"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="60s"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_primary_container"
                    android:contentDescription="Set rest timer to 60 seconds" />

                <Button
                    android:id="@+id/btnTimer90"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="90s"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_primary_container"
                    android:contentDescription="Set rest timer to 90 seconds" />

                <Button
                    android:id="@+id/btnTimer120"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="120s"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_primary_container"
                    android:contentDescription="Set rest timer to 120 seconds" />

                <Button
                    android:id="@+id/btnTimerReset"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_m3_outlined"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_error"
                    android:contentDescription="Reset rest timer" />
            </LinearLayout>
        </LinearLayout>

        <!-- Volume & History Vault Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_m3"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOLUME &amp; HISTORY VAULT"
                android:textColor="@color/m3_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_m3_high"
                    android:padding="14dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Est. Tonnage"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalTonnage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 T"
                        android:textColor="@color/m3_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_m3_high"
                    android:padding="14dp"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed Sets"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalSets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/m3_success"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnExportHistory"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_m3_outlined"
                    android:text="Export"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_surface"
                    android:contentDescription="Export workout history" />

                <Button
                    android:id="@+id/btnCopySummary"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/btn_m3_outlined"
                    android:text="Copy"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_surface"
                    android:contentDescription="Copy workout summary to clipboard" />

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_m3_outlined"
                    android:text="Wipe"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_error"
                    android:contentDescription="Wipe history" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>