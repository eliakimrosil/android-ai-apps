<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/m3_surface"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header & Desktop Mode Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/m3_outline" />
            </LinearLayout>

            <Button
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/btn_m3_outlined"
                android:text="@string/theme_auto"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Sentinel Status & Hero Card -->
        <LinearLayout
            android:id="@+id/cardSentinelHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_m3"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStatusHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_meter_standby"
                android:textColor="@color/m3_outline"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvCountdownTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="@string/timer_placeholder"
                android:textColor="@color/m3_on_surface"
                android:textSize="44sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbParkingProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/m3_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimeTarget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/no_active_session"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEstimatedCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_cost"
                    android:textColor="@color/m3_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnStartParking"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_m3_primary"
                    android:text="@string/action_start_parking"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnStopParking"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="@string/action_stop"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_surface"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnExtend15"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_m3_outlined"
                android:text="@string/action_extend_15"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_surface" />
        </LinearLayout>

        <!-- Duration Adjustment Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_m3_high"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_duration_setting"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvDurationDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_duration"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMinus15"
                        android:layout_width="56dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_stepper"
                        android:text="@string/step_minus_15"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMinus5"
                        android:layout_width="56dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_stepper"
                        android:text="@string/step_minus_5"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPlus5"
                        android:layout_width="56dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_stepper"
                        android:text="@string/step_plus_5"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPlus15"
                        android:layout_width="56dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_stepper"
                        android:text="@string/step_plus_15"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPlus30"
                        android:layout_width="56dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_stepper"
                        android:text="@string/step_plus_30"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPlus60"
                        android:layout_width="56dp"
                        android:layout_height="36dp"
                        android:background="@drawable/btn_stepper"
                        android:text="@string/step_plus_60"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Parking Spot Metadata & Rates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_m3_high"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_spot_details"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etSpotLabel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/edittext_m3"
                    android:hint="@string/hint_spot_level"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/m3_on_surface"
                    android:textColorHint="@color/m3_outline"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etRatePerHour"
                    android:layout_width="100dp"
                    android:layout_height="44dp"
                    android:background="@drawable/edittext_m3"
                    android:hint="@string/hint_rate"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/m3_on_surface"
                    android:textColorHint="@color/m3_outline"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/edittext_m3"
                android:hint="@string/hint_notes"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/m3_on_surface"
                android:textColorHint="@color/m3_outline"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnShareSpot"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_m3_tonal"
                    android:text="@string/action_share"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCopySpot"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_m3_outlined"
                    android:text="@string/action_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Alerts and Sentinel Config -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_m3_high"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvAlertBufferLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alert_buffer_default"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface" />

            <SeekBar
                android:id="@+id/sbAlertBuffer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:max="30"
                android:progress="5"
                android:progressTint="@color/m3_primary"
                android:thumbTint="@color/m3_primary" />

            <Switch
                android:id="@+id/swSound"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/setting_sound_alert"
                android:textColor="@color/m3_on_surface"
                android:checked="true" />

            <Switch
                android:id="@+id/swVibrate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/setting_vibrate_alert"
                android:textColor="@color/m3_on_surface"
                android:checked="true" />

            <Switch
                android:id="@+id/swKeepScreenOn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/setting_keep_screen_on"
                android:textColor="@color/m3_on_surface"
                android:checked="false" />
        </LinearLayout>

        <!-- Parking History & Quick Clear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_recent_sessions"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface" />

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_m3_outlined"
                android:text="@string/action_clear"
                android:textAllCaps="false"
                android:textColor="@color/m3_outline"
                android:textSize="11sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>