<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Panel with Title and Dynamic Theme Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PANFLIP SENTINEL"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvLockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCKED ON PAN • SCREEN AWAKE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@android:drawable/btn_default"
                android:text="Theme: Auto"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- Sear HUD Display Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvPhaseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY FOR PAN CONTACT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginBottom="6dp" />

            <!-- Ultra-Large Telemetry Timer -->
            <TextView
                android:id="@+id/tvTimerDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:00"
                android:textSize="64sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressTimer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="1000"
                android:progress="1000"
                android:progressTint="#FF5722"
                android:layout_marginBottom="12dp" />

            <!-- Flip & Side telemetry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvSideIndicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SIDE 1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFC107" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#444444" />

                <TextView
                    android:id="@+id/tvFlipCounter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0 / 2 FLIPS"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00E5FF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPresetDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ribeye Sear (Med-Rare) — High Cast Iron • 2 min/side"
                android:textSize="12sp"
                android:textColor="#CCCCCC"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Primary Control Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnStartPause"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:text="IGNITE SEAR"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#FF5722"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnManualFlip"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.2"
                android:text="FLIP NOW"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="RESET"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Quick Adjustment Incrementals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnQuickPlus30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+30 SECS"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnQuickMinus15"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-15 SECS"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Presets Selector Scroll -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CULINARY SEAR PRESETS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/layoutPresetContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Custom Manual Configuration Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Duration Per Side:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvDurationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 min 00 sec"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Target Flip Count:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvFlipsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 Flips"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekFlips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Custom Preset Saver -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etProteinName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="New Preset Name..."
                    android:textSize="13sp"
                    android:inputType="textCapWords" />

                <Button
                    android:id="@+id/btnSaveCustomPreset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAVE PRESET"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sentinel Guard & Hardware Toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <Switch
                android:id="@+id/switchKeepScreenOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keep Screen On (Grease-Hand Sentinel)"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp" />

            <Switch
                android:id="@+id/switchSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audible Sear Completion Chime"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp" />

            <Switch
                android:id="@+id/switchVibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tactile Searing Alert Vibration"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- Sear Log & JSON Data Backup Tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RECENT SEAR SESSIONS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary" />

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLEAR"
                android:textSize="10sp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- JSON Import & Export Tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnExportJson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EXPORT JSON"
                android:textSize="12sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnImportJson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IMPORT CLIPBOARD"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>