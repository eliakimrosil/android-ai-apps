<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121214">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IRONPULSE"
                android:textColor="#FF9F0A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100% Offline Gym Tracker &amp; Rest Timer"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Program & Exercise Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C1C1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORKOUT PROGRAM"
                android:textColor="#0A84FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerProgram"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#2C2C2E"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXERCISE TARGET"
                android:textColor="#0A84FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerExercise"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#2C2C2E"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Progressive Overload Cue Card -->
            <TextView
                android:id="@+id/tvProgressiveCue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2C2C2E"
                android:padding="12dp"
                android:text="Overload Cue: Log consistently to unlock suggestions."
                android:textColor="#30D158"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Set Logger Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C1C1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOG ACTIVE SET"
                android:textColor="#0A84FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight (kg)"
                        android:textColor="#AEAEB2"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etWeight"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#2C2C2E"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:hint="e.g. 80.0"
                        android:textColorHint="#636366"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reps Count"
                        android:textColor="#AEAEB2"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etReps"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#2C2C2E"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:hint="e.g. 8"
                        android:textColorHint="#636366"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnLogSet"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Log Set &amp; Trigger Timer"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#FF9F0A" />

            <!-- Active Sets List Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Workout Sets"
                android:textColor="#AEAEB2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/layoutCurrentSetsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnClearCurrentSets"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Clear Sets"
                    android:textAllCaps="false"
                    android:textColor="#FF453A"
                    android:backgroundTint="#2C2C2E" />

                <Button
                    android:id="@+id/btnFinishWorkout"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Finish Workout"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#30D158" />
            </LinearLayout>
        </LinearLayout>

        <!-- Rest Timer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C1C1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REST INTERVAL TIMER"
                android:textColor="#0A84FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvTimerCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="01:30"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbTimer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:progressTint="#0A84FF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">

                <Button
                    android:id="@+id/btnTimer60"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="60s"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E" />

                <Button
                    android:id="@+id/btnTimer90"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="90s"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E" />

                <Button
                    android:id="@+id/btnTimer120"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="120s"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E" />

                <Button
                    android:id="@+id/btnTimerReset"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textColor="#FF453A"
                    android:backgroundTint="#2C2C2E" />
            </LinearLayout>
        </LinearLayout>

        <!-- Volume & History Vault Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C1C1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOLUME &amp; HISTORY VAULT"
                android:textColor="#0A84FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#2C2C2E"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Est. Tonnage"
                        android:textColor="#8E8E93"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalTonnage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 T"
                        android:textColor="#FF9F0A"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#2C2C2E"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed Sets"
                        android:textColor="#8E8E93"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalSets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#30D158"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnExportHistory"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="Export"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E" />

                <Button
                    android:id="@+id/btnCopySummary"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="Copy"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E" />

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:text="Wipe"
                    android:textAllCaps="false"
                    android:textColor="#FF453A"
                    android:backgroundTint="#2C2C2E" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>