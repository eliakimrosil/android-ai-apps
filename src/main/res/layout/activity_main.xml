<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- Header Bar with Theme Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AuraFocus"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minimalist Pomodoro &amp; Soundscape"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Auto Theme"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?android:attr/colorAccent" />
        </LinearLayout>

        <!-- Mode Selectors (Focus, Short Break, Long Break) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnModeFocus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Focus"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnModeShortBreak"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Short Break"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnModeLongBreak"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Long Break"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Big Chronometer Display Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="36dp"
            android:paddingBottom="36dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvModeIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEEP FOCUS INTERVAL"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="?android:attr/colorAccent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTimerDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25:00"
                android:fontFamily="sans-serif-thin"
                android:textSize="76sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/tvSessionCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed Rounds: 0"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Timer Controls (Start/Pause, Reset, Skip) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Reset"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnStartPause"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:text="Start"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSkip"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Skip"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Procedural Ambient Sound Panel -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AMBIENT BACKGROUND SOUND"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAmbientOff"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Mute"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAmbientWhite"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="White Noise"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAmbientPink"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Pink Noise"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAmbientRain"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Rainfall"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAmbientDrone"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Deep Binaural"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volume"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginEnd="12dp" />

            <SeekBar
                android:id="@+id/seekAmbientVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

        <!-- Duration Adjustments -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTERVAL CONFIGURATION"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Focus Interval"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/tvFocusDurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 Min"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?android:attr/colorAccent" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekFocusDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="25"
            android:layout_marginBottom="32dp" />

        <!-- Analytics & Progress Summary -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAILY PRODUCTIVITY TELEMETRY"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Focused"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/tvStatsTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0m"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/tvStatsCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Session History Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SESSION HISTORY"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHistoryLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:padding="12dp"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="?android:attr/textColorSecondary"
            android:text="No sessions completed yet."
            android:layout_marginBottom="16dp" />

        <!-- History Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Clear History"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnShareStats"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Export &amp; Share"
                android:textSize="12sp"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>