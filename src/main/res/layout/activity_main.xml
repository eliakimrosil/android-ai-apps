<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header & System Utility Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RoastRest Sentinel"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carryover Heat &amp; Thermal Equilibrium Engine"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUnitToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display: °F"
                android:textSize="11sp"
                android:minHeight="36dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnThemeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme: Auto"
                android:textSize="11sp"
                android:minHeight="36dp" />
        </LinearLayout>

        <!-- Culinary Telemetry Overview Card -->
        <LinearLayout
            android:id="@+id/cardTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?android:attr/colorBackgroundFloating"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THERMAL PROJECTION (ESTIMATED)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carryover Rise"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvEstCarryover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+8.5°F"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peak Core Temp"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvEstPeakTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="133.5°F"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:id="@+id/tvTargetDiff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-1.5°F vs target"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target Rest"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/tvRecommendedRest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00 min"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvRestAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="Optimal Pull! On track for perfect Medium Rare."
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- Cut & Thermal Profile Configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?android:attr/colorBackgroundFloating"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUT &amp; THERMAL PARAMETERS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="12dp" />

            <!-- Protein Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protein / Cut"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnProteinPrev"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="◀" />

                <TextView
                    android:id="@+id/tvProteinValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Beef Prime Rib / Ribeye"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <Button
                    android:id="@+id/btnProteinNext"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="▶" />
            </LinearLayout>

            <!-- Target Doneness Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Finished Doneness"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnDonenessPrev"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="◀" />

                <TextView
                    android:id="@+id/tvDonenessValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Medium Rare (135°F)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <Button
                    android:id="@+id/btnDonenessNext"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="▶" />
            </LinearLayout>

            <!-- Cooking Method -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cooking Heat Intensity / Method"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnMethodPrev"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="◀" />

                <TextView
                    android:id="@+id/tvMethodValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Oven Roast (350°F)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <Button
                    android:id="@+id/btnMethodNext"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="▶" />
            </LinearLayout>

            <!-- Thickness Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cut Thickness"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/tvThicknessValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.00&quot; / 5.1 cm"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekThickness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="24"
                android:progress="8"
                android:layout_marginBottom="12dp" />

            <!-- Environment Toggles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnToggleBone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Bone: Boneless"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnToggleFoil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Cover: Tented Foil"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Pull Temperature Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Probe Pull Temperature"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnTempMinus"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="-1°" />

                <EditText
                    android:id="@+id/etPullTemp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:text="125.0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <Button
                    android:id="@+id/btnTempPlus"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="+1°" />
            </LinearLayout>
        </LinearLayout>

        <!-- Rest Sentinel Active Timer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?android:attr/colorBackgroundFloating"
            android:elevation="2dp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REST SENTINEL COUNTDOWN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTimerCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/tvTimerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS: STANDBY"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTimerStartPause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Start Rest Timer"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnTimerReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Reset"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnLogResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Log Session"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Thermal Journal & History Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?android:attr/colorBackgroundFloating"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="THERMAL LOG JOURNAL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary" />

                <Button
                    android:id="@+id/btnShareLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export"
                    android:textSize="10sp"
                    android:minHeight="32dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textSize="10sp"
                    android:minHeight="32dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHistoryLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorSecondary"
                android:text="No recorded rests yet. Log your completed roasts to calibrate carryover precision." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>