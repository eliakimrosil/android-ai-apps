<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface"
    android:padding="20dp">

    <!-- Top App Bar & Theme Toggle (Desktop / Tablet Header) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IRONPULSE"
                android:textColor="@color/m3_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Material 3 Expressive • Desktop &amp; Multi-Window Mode"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Mode Indicator / Theme Toggle Button -->
        <Button
            android:id="@+id/btnThemeToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/btn_m3_outlined"
            android:text="🌓 Theme"
            android:textColor="@color/m3_primary"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:contentDescription="Toggle Light and Dark Mode" />
    </LinearLayout>

    <!-- Two-Column Adaptive Split Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- LEFT COLUMN: Active Logger & Controls (Scrollable) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:layout_marginEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Split & Exercise Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_m3"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WORKOUT PROGRAM"
                        android:textColor="@color/m3_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="8dp" />

                    <!-- Program Filter Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnChipPPL"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/chip_active"
                                android:text="Push / Pull / Legs"
                                android:textColor="@color/m3_on_primary"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:textStyle="bold"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btnChipUpperLower"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/chip_inactive"
                                android:text="Upper / Lower"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btnChip5x5"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/chip_inactive"
                                android:text="5x5 Strength"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btnChipCustom"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/chip_inactive"
                                android:text="Custom Split"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <Spinner
                        android:id="@+id/spinnerProgram"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET EXERCISE"
                        android:textColor="@color/m3_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spinnerExercise"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/card_m3_high"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Progressive Overload Cue -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_m3_high"
                        android:padding="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProgressiveCue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Overload Cue: Log consistently to unlock suggestions."
                            android:textColor="@color/m3_success"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Active Set Logger Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_m3"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOG ACTIVE SET"
                        android:textColor="@color/m3_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="10dp">

                        <!-- Weight -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weight (kg) [Key: + / -]"
                                android:textColor="@color/m3_on_surface_variant"
                                android:textSize="11sp"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/etWeight"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edittext_m3"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="15sp"
                                android:padding="10dp"
                                android:hint="80.0"
                                android:textColorHint="@color/m3_outline_variant"
                                android:inputType="numberDecimal" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="4"
                                android:layout_marginTop="6dp">

                                <Button
                                    android:id="@+id/btnWeightMinus5"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="2dp"
                                    android:background="@drawable/btn_stepper"
                                    android:text="-5"
                                    android:textSize="10sp"
                                    android:textColor="@color/m3_on_surface" />

                                <Button
                                    android:id="@+id/btnWeightMinus25"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="2dp"
                                    android:background="@drawable/btn_stepper"
                                    android:text="-2.5"
                                    android:textSize="10sp"
                                    android:textColor="@color/m3_on_surface" />

                                <Button
                                    android:id="@+id/btnWeightPlus25"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="2dp"
                                    android:background="@drawable/btn_stepper"
                                    android:text="+2.5"
                                    android:textSize="10sp"
                                    android:textColor="@color/m3_primary"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btnWeightPlus5"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/btn_stepper"
                                    android:text="+5"
                                    android:textSize="10sp"
                                    android:textColor="@color/m3_primary"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Reps -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reps [Key: [ / ]]"
                                android:textColor="@color/m3_on_surface_variant"
                                android:textSize="11sp"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/etReps"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edittext_m3"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="15sp"
                                android:padding="10dp"
                                android:hint="8"
                                android:textColorHint="@color/m3_outline_variant"
                                android:inputType="number" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="4"
                                android:layout_marginTop="6dp">

                                <Button
                                    android:id="@+id/btnRepsMinus5"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="2dp"
                                    android:background="@drawable/btn_stepper"
                                    android:text="-5"
                                    android:textSize="10sp"
                                    android:textColor="@color/m3_on_surface" />

                                <Button
                                    android:id="@+id/btnRepsMinus1"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="2dp"
                                    android:background="@drawable/btn_stepper"
                                    android:text="-1"
                                    android:textSize="10sp"
                                    android:textColor="@color/m3_on_surface" />

                                <Button
                                    android:id="@+id/btnRepsPlus1"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="2dp"
                                    android:background="@drawable/btn_stepper"
                                    android:text="+1"
                                    android:textSize="10sp"
                                    android:textColor="@color/m3_primary"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btnRepsPlus5"
                                    android:layout_width="0dp"
                                    android:layout_height="30dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/btn_stepper"
                                    android:text="+5"
                                    android:textSize="10sp"
                                    android:textColor="@color/m3_primary"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnLogSet"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_m3_primary"
                        android:text="Log Set &amp; Start Timer [Enter]"
                        android:textAllCaps="false"
                        android:textColor="@color/m3_on_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Active Workout Sets in Left Column -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Workout Sets"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:id="@+id/layoutCurrentSetsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/btnClearCurrentSets"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/btn_m3_outlined"
                            android:text="Clear Sets"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_error" />

                        <Button
                            android:id="@+id/btnFinishWorkout"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/btn_m3_tonal"
                            android:text="Finish Workout"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_on_primary_container"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Rest Timer Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_m3"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REST INTERVAL TIMER [Key: Space]"
                        android:textColor="@color/m3_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTimerCountdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="01:30"
                        android:textColor="@color/m3_primary"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbTimer"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:progressTint="@color/m3_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <Button
                            android:id="@+id/btnTimer60"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/btn_m3_tonal"
                            android:text="60s"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_on_primary_container" />

                        <Button
                            android:id="@+id/btnTimer90"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="2dp"
                            android:background="@drawable/btn_m3_tonal"
                            android:text="90s"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_on_primary_container" />

                        <Button
                            android:id="@+id/btnTimer120"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="2dp"
                            android:background="@drawable/btn_m3_tonal"
                            android:text="120s"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_on_primary_container" />

                        <Button
                            android:id="@+id/btnTimerReset"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:background="@drawable/btn_m3_outlined"
                            android:text="Reset"
                            android:textAllCaps="false"
                            android:textColor="@color/m3_error" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- RIGHT COLUMN: Volume Vault & History Analytics (Scrollable) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_m3"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLUME &amp; HISTORY VAULT"
                    android:textColor="@color/m3_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="10dp" />

                <!-- Tonnage & Sets Summary Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_m3_high"
                        android:padding="12dp"
                        android:orientation="vertical"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Est. Tonnage"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvTotalTonnage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 T"
                            android:textColor="@color/m3_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_m3_high"
                        android:padding="12dp"
                        android:orientation="vertical"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed Sets"
                            android:textColor="@color/m3_on_surface_variant"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvTotalSets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/m3_success"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- History Entries Feed -->
                <LinearLayout
                    android:id="@+id/layoutHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp" />

                <!-- Action Tools -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <Button
                        android:id="@+id/btnExportHistory"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/btn_m3_outlined"
                        android:text="Export"
                        android:textAllCaps="false"
                        android:textColor="@color/m3_on_surface" />

                    <Button
                        android:id="@+id/btnCopySummary"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/btn_m3_outlined"
                        android:text="Copy"
                        android:textAllCaps="false"
                        android:textColor="@color/m3_on_surface" />

                    <Button
                        android:id="@+id/btnClearHistory"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/btn_m3_outlined"
                        android:text="Wipe"
                        android:textAllCaps="false"
                        android:textColor="@color/m3_error" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
