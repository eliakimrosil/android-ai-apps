<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/studio_panel_recessed" />
            <stroke android:width="1.5dp" android:color="@color/studio_border_focus" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/studio_panel_recessed" />
            <stroke android:width="1dp" android:color="@color/studio_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
